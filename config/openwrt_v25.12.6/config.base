# MANAGED by apply-stable.sh -- jangan diedit (ditimpa saat skrip dijalankan ulang).
# Tambahan/override milikmu taruh di config.user (dibaca setelah file ini, jadi menang).

#### TARGET: wajib untuk OPHUB (armsr/armv8 generic, hasil rootfs.tar.gz) ####
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_EROFS is not set
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_USE_APK=y

#### OPHUB inti: dipakai script packaging & luci-app-amlogic ####
CONFIG_PACKAGE_luci-app-amlogic=y
CONFIG_PACKAGE_luci-i18n-amlogic-zh-cn=y
