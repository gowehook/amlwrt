# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_ipset=y

#### OVERLAY OPHUB: pilihan config OPHUB (openwrt_main) yang diterapkan ke stable ####
# Sumber: perbandingan config OPHUB main vs default 25.12.6. Hanya paket userspace (tanpa kmod-*,
# karena /lib/modules diganti kernel OPHUB) dan sub-opsi paket. TLS: OpenSSL menggantikan mbedTLS.
CONFIG_ATH10K_LEDS=y
CONFIG_ATH9K_HWRNG=y
CONFIG_ATH_USER_REGD=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BTRFS_PROGS_ZSTD=y
CONFIG_BUSYBOX_DEFAULT_FEATURE_EDITING_HISTORY=2000
CONFIG_BUSYBOX_DEFAULT_FEATURE_REVERSE_SEARCH=y
CONFIG_BUSYBOX_DEFAULT_FEATURE_SH_HISTFILESIZE=y
CONFIG_BUSYBOX_DEFAULT_FEATURE_TRACEROUTE_USE_ICMP=y
CONFIG_BUSYBOX_DEFAULT_TIMEOUT=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=2
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
CONFIG_GNUTLS_ALPN=y
CONFIG_GNUTLS_ANON=y
CONFIG_GNUTLS_DTLS_SRTP=y
